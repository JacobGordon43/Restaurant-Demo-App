@model IEnumerable<Restaurant_Demo_App.Models.DayOpenModel>

@if (TempData["HoursSuccess"] != null)
{
    <div class="message-box bg-green-300 mx-auto">@TempData["HoursSuccess"]</div>
}
else if (TempData["HoursFailure"] != null)
{
    <div class="message-box bg-red-300 mx-auto">@TempData["HoursFailure"]</div>
}
@foreach(var item in Model){

 <partial name="_BusinessHoursFormPartial" model="@item" />
}
<a asp-action="CreateHoursView" class="btn bg-blue-400 hover:bg-blue-500">Add Business Hours</a>
