@model Restaurant_Demo_App.Models.AboutContentModel
@if (TempData["AboutSuccess"] != null)
{
    <div class="message-box bg-green-300 mx-auto">@TempData["AboutSuccess"]</div>
}
else if (TempData["AboutFailure"] != null)
{
    <div class="message-box bg-red-300 mx-auto">@TempData["AboutFailure"]</div>
}
<form asp-action="UpdateAbout">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="field-container">
        <label asp-for="Content">Content</label>
            <textarea asp-for="Content" class="menu-item-input">@Model.Content</textarea>
            <span asp-validation-for="Content" class="bg-red-300"></span>
    </div>
    <button type="submit" class="btn bg-green-400 hover:bg-green-500">Update About Page</button>
</form>
