@model IEnumerable<Restaurant_Demo_App.Models.ImageModel>

@{
    ViewData["Title"] = "Slideshow";
}

<h1>Slideshow</h1>

@if (TempData["SlideshowSuccess"] != null)
{
    <div class="message-box bg-green-300 mx-auto">@TempData["SlideshowSuccess"]</div>
}
else if (TempData["MenuFailure"] != null)
{
    <div class="message-box bg-red-300 mx-auto">@TempData["SlideshowFailure"]</div>
}
@foreach (var item in Model) {
    <partial name="_SlideshowFormPartial" model="@item"/>
}
<a asp-action="CreateImageView" class="btn bg-blue-400 hover:bg-blue-500">Add Image</a>

