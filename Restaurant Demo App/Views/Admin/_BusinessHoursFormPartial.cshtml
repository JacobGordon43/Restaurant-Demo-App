@model Restaurant_Demo_App.Models.DayOpenModel

<form asp-action="InsertHours">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="category-container flex mb-4 flex-col">
        <div class="field-container hidden">
            <label asp-for="Id"></label>
            <input asp-for="Id" class="menu-item-input" />
            <span asp-validation-for="Id" class="text-danger"></span>
        </div>
        <div class="field-container">
            <label asp-for="Day"></label>
            <input asp-for="Day" class="menu-item-input" />
            <span asp-validation-for="Day" class="text-danger"></span>
        </div>
        <div class="field-container">
            <label asp-for="OpenTime"></label>
            <input asp-for="OpenTime" class="menu-item-input" />
            <span asp-validation-for="OpenTime" class="text-danger"></span>
        </div>
        <div class="field-container">
            <label asp-for="CloseTime" class="control-label"></label>
            <input asp-for="CloseTime" class="menu-item-input" />
            <span asp-validation-for="CloseTime" class="text-danger"></span>
        </div>
        <div class="field-container">
            <label class="mx-auto my-4">
                <input class="form-check-input" asp-for="IsClosed" /> @Html.DisplayNameFor(model => model.IsClosed)
            </label>
        </div>

        <div class="flex flex-row gap-2">
            <button type="submit" class="btn mx-auto bg-green-400 hover:bg-green-500">Save Hours</button>
            <button asp-action="DeleteItem" class="btn mx-auto bg-red-400 hover:bg-red-500">Delete</button>
        </div>
    </div>
</form>
<hr class="m-2" />