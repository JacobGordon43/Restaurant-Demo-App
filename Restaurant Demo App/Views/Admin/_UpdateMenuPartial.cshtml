@model IEnumerable<Restaurant_Demo_App.Models.MenuCategoryModel>
<div>
    <div class="menu-slider text-center mx-auto">
        @foreach (var item in Model)
        {
            <div class="flex flex-col">
                <div class="menu-category text-xl" onclick="selectCategory('@item.Category')">@item.Category</div>
            </div>
        }
    </div>
    @foreach (var item in Model)
    {
        <form id="@item.Category-category" class="hidden ">
        @foreach(var menuItem in item.Items)
        {
            <div class="category-container flex my-4 flex-col">
                <label>Name</label>
                <input value="@menuItem.name" />
                <label>Description</label>
                <input value="@menuItem.description" />                
                <label>Calories</label>
                <input value="@menuItem.calories" />                
                <label>Price</label>
                <input value="@menuItem.price" />
            </div>
                <hr class="m-2"/>
        }
        </form>
    
    }

    <script>

        if (@Model.Count() > 7) {
            var desktopSlidesToShow = 7
        } else {
            var desktopSlidesToShow = @Model.Count()
                }
        $(".menu-slider").slick({
            slidesToShow: (@Model.Count()  > 3 ? 3 : @Model.Count()),
            slidesToScroll: 1,
            infinite: false,
            mobileFirst: true,
            responsive: [
                {
                    breakpoint: 1024,
                    settings: {
                        slidesToShow: (@Model.Count()  > 5 ? 5 : @Model.Count()),
                    }
                }
            ]
        });

        function selectCategory(category) {
            $('.active-menu').removeClass("active-menu");
            $("#" + category + "-category").addClass("active-menu");
        }
    </script>
</div>