@model Restaurant_Demo_App.Models.DayOpenModel

@{
    ViewData["Title"] = "Create Hours";
}
<div class="w-[90vw]">
    <form asp-action="CreateHours">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="category-container flex mb-4 flex-col">
            <div class="field-container hidden">
                <label asp-for="Id" class="hidden"></label>
                <input asp-for="Id" class="menu-item-input hidden" />
                <span asp-validation-for="Id" class="text-danger hidden"></span>
            </div>
            <div class="field-container">
                <label asp-for="Day"></label>
                <input asp-for="Day" class="menu-item-input" />
                <span asp-validation-for="Day" class="text-danger"></span>
            </div>
            <div class="field-container">
                <label asp-for="OpenTime"></label>
                <input id="OpenTime" asp-for="OpenTime" class="menu-item-input" />
                <span asp-validation-for="OpenTime" class="text-danger"></span>
            </div>
            <div class="field-container">
                <label asp-for="CloseTime" class="control-label"></label>
                <input id="ClosedTime" asp-for="CloseTime" class="menu-item-input" />
                <span asp-validation-for="CloseTime" class="text-danger"></span>
            </div>
            <div class="field-container">
                <label class="mx-auto my-4">
                    <input id="is-closed" class="form-check-input" asp-for="IsClosed" onclick="checked"/> Closed
                </label>
            </div>

            <div class="flex flex-row gap-2">
                <button type="submit" class="btn mx-auto bg-green-400 hover:bg-green-500">Create Hours</button>
                <a asp-action="Index" class="btn bg-blue-400 hover:bg-blue-500">Return Home</a>
            </div>
        </div>
    </form>
</div>


<script>
    $(document).ready(function () {
        $("#is-closed").click(function(){
            if($("#is-closed").is(":checked")){
                $("#OpenTime").attr("disabled", true);
                $("#ClosedTime").attr("disabled", true);

            }else{
                $("#OpenTime").attr("disabled", false);
                $("#ClosedTime").attr("disabled", false);
            }
        })
    })
</script>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
