@model IEnumerable<Restaurant_Demo_App.Models.MenuCategoryModel>

<div class="menu-slider text-center mx-auto">
    @foreach(var item in Model)
    {
        <div class="flex flex-col">
            <div class="menu-category text-xl" onclick="selectCategory('@item.Category')">@item.Category</div>
        </div>
    }
</div>
@foreach(var item in Model){
    int count = 0;

    <div id="@item.Category-category" class="menu-container hidden mx-auto">
        <div class="menu-item hidden lg:flex flex-row w-full">
            <div class="item-col w-[100px]">Dish</div>
            <div class="item-col w-[300px] lg:w-[600px]">Description</div>
            <div class="item-col w-[100px]">Calories</div>
            <div class="item-col w-[100px]">Peanuts</div>
            <div class="item-col w-[100px]">Glutten</div>
            <div class="item-col w-[100px]">Vegan</div>
            <div class="item-col w-[100px]">Price</div>
        </div>
        @foreach (var menuItem in item.Items)
        //TODO hide all of this and use an active class to display it at 90vw. Use the category as a class to help in setting it to active
        {
            count++;
            <div class="menu-item flex flex-col lg:flex-row w-full mx-auto">
                <div class="item-col w-full lg:w-[100px]">@menuItem.Name</div>
                <div class="item-col w-full">@menuItem.Description</div>
                <div class="item-col w-full lg:w-[150px]">@menuItem.Calories calories</div>
                <div class="icons-row flex flex-row">
                    <div class="item-col w-full lg:w-[100px]">
                    @if (@menuItem.Peanuts)
                    {
                        <img class="w-[40px] mx-auto" src="images/peanut.png" />
                    }
                    </div>
                    <div class="item-col w-full lg:w-[100px]">
                    @if (!@menuItem.Gluten)
                    {
                        <img class="w-[40px] mx-auto" src="images/glutenfree.png" />
                    }
                    </div>
                    <div class="item-col w-full lg:w-[100px]">
                        @if (@menuItem.Vegan)
                        {
                            <img class="w-[40px] mx-auto" src="images/vegan.png" />
                        }

                    </div>
                </div>
                <div class="item-col w-full lg:w-[100px]">$@menuItem.Price</div>
            </div>
            if(count <= item.Items.Count() - 1)
            {
                <hr class="m-2" />
            }
        }
    </div>
}

<script>
    if (@Model.Count() > 7) {
        var desktopSlidesToShow = 7
    } else {
        var desktopSlidesToShow = @Model.Count()
        }
    $(".menu-slider").slick({
        slidesToShow: (@Model.Count()  > 3 ? 3 : @Model.Count()) ,
        slidesToScroll: 1,
        infinite: false,
        mobileFirst: true,
        responsive: [
            {
                breakpoint: 1024,
                settings: {
                    slidesToShow: (@Model.Count()  > 5 ? 5 : @Model.Count()),
                }
            }
        ]
    });

    function selectCategory(category) {
        $('.active-menu').removeClass("active-menu");
        $("#" + category + "-category").addClass("active-menu");
    }
</script>