@model IEnumerable<Restaurant_Demo_App.Models.MenuCategoryModel>

<div class="menu-slider text-center mx-auto">
    @foreach(var item in Model)
    {
        <div class="flex flex-col">
            <div class="menu-category text-xl" onclick="selectCategory('@item.category')">@item.category</div>
        </div>
    }
</div>
@foreach(var item in Model){
    <div id="@item.category-category" class="menu-container hidden">

        @foreach (var menuItem in item.items)
        //TODO hide all of this and use an active class to display it at 90vw. Use the category as a class to help in setting it to active
        {
            <div class="menu-item flex flex-row w-full">
                <div class="item-col">@menuItem.name</div>
                <div class="item-col">@menuItem.description</div>
                <div class="item-col">@menuItem.calories</div>
                <div class="item-col">@(@menuItem.peanuts ? "Includes Peanuts" : "")</div>
                <div class="item-col">@menuItem.price</div>
            </div>
        }
    </div>
}

<script>
    if (@Model.Count() > 7) {
        var desktopSlidesToShow = 7
    } else {
        var desktopSlidesToShow = @Model.Count()
        }
    $(".menu-slider").slick({
        slidesToShow: (@Model.Count()  > 3 ? 3 : @Model.Count()) ,
        slidesToScroll: 1,
        infinite: false,
        mobileFirst: true,
        responsive: [
            {
                breakpoint: 1024,
                settings: {
                    slidesToShow: (@Model.Count()  > 5 ? 5 : @Model.Count()),
                }
            }
        ]
    });

    function selectCategory(category) {
        $('.active-menu').removeClass("active-menu");
        $("#" + category + "-category").addClass("active-menu");
    }
</script>