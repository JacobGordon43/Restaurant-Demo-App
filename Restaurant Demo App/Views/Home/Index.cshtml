@model Restaurant_Demo_App.Models.HomePageModel

@{
    ViewData["Title"] = "Home Page";
}

<div>
    <div class="slideshow w-screen max-w-[600px] mx-auto my-4">
        @foreach (var item in Model.Images)
        {
            <figure>
                <img src=@item.Source alt=@item.Caption />
                <figcaption class="caption">@item.Caption</figcaption>
            </figure>
        }
    </div>
    <partial name="_MenuPartial" model=Model.Menu/>
</div>
<script>
    $(".slideshow").slick({
        dots: true,
        arrows: false,
        infinite: true,
        slidesToShow: 1,
        slidesToScroll: 1,
        autoplay: true,
        autoplaySpeed: 3000
    })
    $(document).ready(function () {
        $(".active").toggleClass(".active");
        $("#home").toggleClass(".active");
    })
</script>
